# Globexa CRM Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD="" # REQUIRED: generate a unique local/deployment password
DATABASE_NAME=globexa_crm
# Optional: Full connection string (overrides individual settings above)
# DATABASE_URL=postgresql+asyncpg://<runtime-user>:<password>@localhost:5432/globexa_crm

# =============================================================================
# REDIS (Celery broker, caching, sessions)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD="" # Set locally when enabled
# Optional: Full connection string
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY (JWT, Passwords)
# =============================================================================
# Generate with: openssl rand -hex 32
SECURITY_SECRET_KEY="" # REQUIRED: generate at least 32 random bytes; never reuse provider credentials
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=30
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_BCRYPT_ROUNDS=12

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="" # Set locally when enabled
GOOGLE_CLIENT_SECRET="" # Set locally when enabled
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# =============================================================================
# AI ROUTER - NVIDIA NIM (Primary Cloud Provider)
# =============================================================================
# Get API key from: https://build.nvidia.com/
NVIDIA_API_KEY="" # Set locally when enabled

# =============================================================================
# AI ROUTER - Alternative Cloud Providers (Optional)
# =============================================================================
OPENAI_API_KEY="" # Set locally when enabled
ANTHROPIC_API_KEY="" # Set locally when enabled
GOOGLE_API_KEY="" # Set locally when enabled

# =============================================================================
# AI ROUTER - Local Ollama
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# =============================================================================
# EMAIL PROVIDERS
# =============================================================================
# Resend (Primary)
RESEND_API_KEY="" # Set locally when enabled
RESEND_WEBHOOK_SECRET="" # Set locally when enabled

# Gmail / Google Workspace
GMAIL_CLIENT_ID="" # Set locally when enabled
GMAIL_CLIENT_SECRET="" # Set locally when enabled

# Microsoft Graph
MS_GRAPH_CLIENT_ID="" # Set locally when enabled
MS_GRAPH_CLIENT_SECRET="" # Set locally when enabled
MS_GRAPH_TENANT_ID="" # Set locally when enabled

# SMTP (Generic)
SMTP_HOST="" # Set locally when enabled
SMTP_PORT=587
SMTP_USERNAME="" # Set locally when enabled
SMTP_PASSWORD="" # Set locally when enabled
SMTP_USE_TLS=true

# =============================================================================
# CELERY (Background Workers)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH="" # Set locally when enabled

# =============================================================================
# FRONTEND (for CORS, email links, etc.)
# =============================================================================
FRONTEND_URL=http://localhost:3000
# Independent Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_CREDENTIAL_ENCRYPTION_KEY="" # Set locally when enabled
# Separate migration and runtime role passwords for docker-compose.production.yml
MIGRATION_DATABASE_PASSWORD="" # Set locally when enabled
RUNTIME_DATABASE_PASSWORD="" # Set locally when enabled

# Checkpoint 5/6 controlled provider applications; inject secrets through deployment configuration.
CRM_PUBLIC_BASE_URL="" # HTTPS origin used in campaign unsubscribe links
CRM_GMAIL_CLIENT_ID="" # Gmail OAuth app
CRM_GMAIL_CLIENT_SECRET="" # Inject through the secret manager
CRM_GMAIL_REDIRECT_URI="" # EXACT format: https://<frontend-origin>/integrations/callback
CRM_OUTLOOK_CLIENT_ID="" # Microsoft OAuth app
CRM_OUTLOOK_CLIENT_SECRET="" # Inject through the secret manager
CRM_OUTLOOK_REDIRECT_URI="" # EXACT format: https://<frontend-origin>/integrations/callback
CRM_AI_PROVIDER="" # e.g. nvidia, openai, deepseek or ollama (local alias)
CRM_AI_MODEL="" # Explicit configured model
CRM_AI_BASE_URL="" # Compatible API base, or native Ollama root e.g. http://127.0.0.1:11434
CRM_AI_API_KEY="" # Inject through the secret manager; not required for local Ollama

# Additional OAuth providers. The same browser callback route is registered per app.
CRM_META_CLIENT_ID=""
CRM_META_CLIENT_SECRET=""
CRM_META_REDIRECT_URI="" # https://<frontend-origin>/integrations/callback
CRM_INSTAGRAM_CLIENT_ID=""
CRM_INSTAGRAM_CLIENT_SECRET=""
CRM_INSTAGRAM_REDIRECT_URI="" # https://<frontend-origin>/integrations/callback
CRM_LINKEDIN_CLIENT_ID=""
CRM_LINKEDIN_CLIENT_SECRET=""
CRM_LINKEDIN_REDIRECT_URI="" # https://<frontend-origin>/integrations/callback
CRM_GOOGLE_ADS_CLIENT_ID=""
CRM_GOOGLE_ADS_CLIENT_SECRET=""
CRM_GOOGLE_ADS_REDIRECT_URI="" # https://<frontend-origin>/integrations/callback
CRM_GOOGLE_ADS_DEVELOPER_TOKEN=""
# Explicit API version selected for your approved provider application, e.g. v25.0 / v24.
CRM_META_GRAPH_VERSION=""
CRM_GOOGLE_ADS_API_VERSION=""
# Enrichment may consume provider credits; leave disabled until separately authorized.
CRM_APOLLO_ENRICHMENT_ENABLED=false
# WhatsApp bearer tokens and Apollo API keys are per-tenant encrypted credentials,
# NOT global environment defaults. Configure through /integrations/{id}/credentials.
# Phone/page/form/customer IDs belong in the tenant integration configuration.
# Meta webhook POST uses the app signing secret; GET uses a DIFFERENT verify_token.
# See docs/checkpoint56/PROVIDER_CONTRACTS.md for callback routes and supported scope.

# Globexa CRM Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=globexa_crm
# Optional: Full connection string (overrides individual settings above)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/globexa_crm

# =============================================================================
# REDIS (Celery broker, caching, sessions)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD="" # Set locally when enabled
# Optional: Full connection string
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY (JWT, Passwords)
# =============================================================================
# Generate with: openssl rand -hex 32
SECURITY_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=30
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_BCRYPT_ROUNDS=12

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="" # Set locally when enabled
GOOGLE_CLIENT_SECRET="" # Set locally when enabled
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# =============================================================================
# AI ROUTER - NVIDIA NIM (Primary Cloud Provider)
# =============================================================================
# Get API key from: https://build.nvidia.com/
NVIDIA_API_KEY="" # Set locally when enabled

# =============================================================================
# AI ROUTER - Alternative Cloud Providers (Optional)
# =============================================================================
OPENAI_API_KEY="" # Set locally when enabled
ANTHROPIC_API_KEY="" # Set locally when enabled
GOOGLE_API_KEY="" # Set locally when enabled

# =============================================================================
# AI ROUTER - Local Ollama
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# =============================================================================
# EMAIL PROVIDERS
# =============================================================================
# Resend (Primary)
RESEND_API_KEY="" # Set locally when enabled
RESEND_WEBHOOK_SECRET="" # Set locally when enabled

# Gmail / Google Workspace
GMAIL_CLIENT_ID="" # Set locally when enabled
GMAIL_CLIENT_SECRET="" # Set locally when enabled

# Microsoft Graph
MS_GRAPH_CLIENT_ID="" # Set locally when enabled
MS_GRAPH_CLIENT_SECRET="" # Set locally when enabled
MS_GRAPH_TENANT_ID="" # Set locally when enabled

# SMTP (Generic)
SMTP_HOST="" # Set locally when enabled
SMTP_PORT=587
SMTP_USERNAME="" # Set locally when enabled
SMTP_PASSWORD="" # Set locally when enabled
SMTP_USE_TLS=true

# =============================================================================
# CELERY (Background Workers)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH="" # Set locally when enabled

# =============================================================================
# FRONTEND (for CORS, email links, etc.)
# =============================================================================
FRONTEND_URL=http://localhost:3000
# Independent Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_CREDENTIAL_ENCRYPTION_KEY="" # Set locally when enabled
# Separate migration and runtime role passwords for docker-compose.production.yml
MIGRATION_DATABASE_PASSWORD="" # Set locally when enabled
RUNTIME_DATABASE_PASSWORD="" # Set locally when enabled
